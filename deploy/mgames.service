[Unit]
Description=MGames Webman Service
After=network-online.target mysql.service redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=www
Group=www
WorkingDirectory=/www/wwwroot/game-platform/server
ExecStart=/www/server/php/84/bin/php webman start
ExecReload=/www/server/php/84/bin/php webman reload
ExecStop=/www/server/php/84/bin/php webman stop
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
LimitNOFILE=65535
UMask=0027

[Install]
WantedBy=multi-user.target
